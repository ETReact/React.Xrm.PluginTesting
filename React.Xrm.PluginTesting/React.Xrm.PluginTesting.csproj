<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>React.Xrm.PluginTesting</RootNamespace>
    <AssemblyName>React.Xrm.PluginTesting</AssemblyName>
    <Deterministic>true</Deterministic>

    <PackageId>React.Xrm.PluginTesting</PackageId>
    <Version>1.0.1</Version>
    <Authors>ETReact</Authors>
    <Description>NuGet package that provides utility classes to generate a Local Execution Context for testing and debugging D365 Plugins locally</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Template.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Template.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.103" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>